{
  "expo": {
    "name": "FootPro",
    "slug": "footpro",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "footpro",
    "userInterfaceStyle": "light",
     "experiments": {
      "baseUrl": "/attendance-app"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FootPro needs your location to verify you are at an authorized work location before allowing punch in/out.",
        "NSFaceIDUsageDescription": "FootPro uses Face ID to securely verify your identity for attendance actions."
      }
    },
    "android": {
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.banuchandar93.footpro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FootPro needs your location to verify your attendance location."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "FootPro uses Face ID to verify your identity."
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "eas": {
        "projectId": "03506b56-9572-4632-a36e-e40959e15855"
      }
    }
  }
}
